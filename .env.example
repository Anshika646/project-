# ==============================================================================
# EDUNEXA ERP — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE SUPABASE CREDENTIALS (Vite Bundled - Public & RLS-Protected)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Key (starts with eyJ... or sb_pub_...)
# Safe to expose in the browser; table-level RLS policies govern all access.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional alias for Publishable Key (if using new Supabase project format):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_...

# Optional: Supabase Project ID (e.g., aja5zsycec6qbeo5epffml)
# VITE_SUPABASE_PROJECT_ID=your-project-id

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (Never prefixed with VITE_; Never in client code)
# ------------------------------------------------------------------------------
# Service Role Key for administrative CLI scripts (npm run seed).
# WARNING: NEVER expose this key in frontend code or commit it to GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. APPLICATION & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
GEMINI_API_KEY=